{
  "name": "@cychien/ezdesign",
  "version": "0.8.0",
  "description": "Annotate your live dev app in the browser; feedback flows to your local coding agent, which edits the source. Review, iterate, repeat.",
  "type": "module",
  "author": "Justin Chien",
  "homepage": "https://github.com/cychien/ezdesign#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cychien/ezdesign.git"
  },
  "bugs": {
    "url": "https://github.com/cychien/ezdesign/issues"
  },
  "bin": {
    "ezdesign": "dist/cli.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs"
    }
  },
  "files": [
    "dist",
    "skills/ezdesign",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:agent": "node scripts/dev-agent.mjs",
    "dev:cli": "node scripts/dev-cli.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit && tsc -p fixtures/playground --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "version": "node scripts/sync-skill-version.mjs && git add skills/ezdesign/SKILL.md",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "review",
    "annotation",
    "feedback",
    "dev-server",
    "vite",
    "claude-code"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@babel/parser": "^7.26.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.3",
    "magic-string": "^0.30.17",
    "open": "^10.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
