{
  "manifest_version": 3,
  "name": "ezdesign capture",
  "description": "把網頁上的圖片、影片和截圖存進 ezdesign 的設計收藏",
  "version": "0.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "offscreen",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "截取區域存至 ezdesign",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "optional_permissions": [
    "webRequest"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "capture-region": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "截取區域存至 ezdesign"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dialog.html",
        "dialog.js",
        "dialog.css"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ]
}
