{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "@cychien/ezdesign",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true,
      "exclude-paths": ["desktop", "website"],
      "extra-files": ["skills/ezdesign/SKILL.md"]
    },
    "desktop": {
      "release-type": "node",
      "package-name": "@cychien/ezdesign-desktop",
      "component": "desktop",
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true
    }
  }
}
