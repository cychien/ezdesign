---
import Lockup from './Lockup.astro'
import { SOCIAL_PATHS } from '../lib/agents'
import { messages } from '../i18n'
import { LINKS } from '../lib/links'

const t = messages(Astro.currentLocale).footer

const COLUMNS = [
  {
    title: t.product,
    links: [
      [t.features, '#features'],
      [t.library, '#library'],
      [t.extension, '#library'],
      [t.changelog, LINKS.releases],
    ],
  },
  {
    title: t.docs,
    links: [
      [t.gettingStarted, LINKS.docs],
      [t.skill, LINKS.skill],
      [t.cli, LINKS.docs],
      [t.faq, '#faq'],
    ],
  },
  {
    title: t.worksWith,
    links: [
      ['Claude Code', 'https://www.anthropic.com/claude-code'],
      ['Codex', 'https://openai.com/codex'],
      ['Cursor', 'https://cursor.com'],
      [t.anyAgent, LINKS.docs],
    ],
  },
  {
    title: t.community,
    links: [
      ['GitHub', LINKS.github],
      ['npm', LINKS.npm],
      [t.issue, LINKS.issues],
      [t.releases, LINKS.releases],
    ],
  },
]

const SOCIAL = [
  ['GitHub', LINKS.github, SOCIAL_PATHS.github],
  ['npm', LINKS.npm, SOCIAL_PATHS.npm],
]
---

<footer>
  <div class="in">
    <div>
      <Lockup height={22} class="brand" />
      <p class="tag">{t.tag}</p>
      <div class="lic"><i></i>{t.license}</div>
      <div class="soc">
        {
          SOCIAL.map(([name, href, path]) => (
            <a href={href} aria-label={name}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={path} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
    {
      COLUMNS.map(({ title, links }) => (
        <nav aria-label={title}>
          <h5>{title}</h5>
          <ul>
            {links.map(([label, href]) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
</footer>

<style>
  footer {
    padding: 56px 0 64px;
    background: #1c1b19;
    color: #a8a6a0;
    font-size: 14px;
  }

  .in {
    display: grid;
    grid-template-columns: 1.7fr repeat(4, 1fr);
    gap: 32px;
    width: var(--wrap);
    margin: 0 auto;
  }

  footer :global(.brand) {
    color: #fff;
  }

  .tag {
    max-width: 250px;
    margin: 18px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: #c9c7c0;
  }

  .lic {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 16px;
    font-size: 13px;
    color: #8a8882;
  }

  .lic i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: #cee7c1;
  }

  .soc {
    display: flex;
    gap: 18px;
    margin-top: 28px;
    color: #c9c7c0;
  }

  h5 {
    margin: 0 0 18px;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
  }

  ul {
    display: grid;
    gap: 13px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    transition: color 0.15s ease;
  }

  a:hover {
    color: #fff;
  }

  @media (max-width: 900px) {
    .in {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 24px;
    }

    .in > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
