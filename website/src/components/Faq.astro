---
import { messages } from '../i18n'

const t = messages(Astro.currentLocale).faq
---

<section id="faq">
  <div class="kicker">{t.kicker}</div>
  <h2>{t.title}</h2>
  <dl class="faq">
    {
      t.questions.map(([question, answer]) => (
        <div class="qa">
          <dt>{question}</dt>
          <dd>{answer}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 48px;
    margin: 40px 0 0;
  }

  .qa {
    padding: 22px 0;
    border-top: 1px solid var(--edge);
  }

  dt {
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  dd {
    margin: 8px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
