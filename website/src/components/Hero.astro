---
import Command from './Command.astro'
import { messages } from '../i18n'
import { AGENT_LOGOS } from '../lib/agents'
import { DOWNLOAD, INSTALL, LINKS } from '../lib/links'

const t = messages(Astro.currentLocale).hero
---

<header class="hero" id="get-started">
  <span class="eyebrow"><b>MIT</b>{t.eyebrow}</span>
  <h1 set:html={t.title} />
  <p class="lede" set:html={t.lede} />
  <div class="cta">
    <span class="download">
      <a class="btn ink get" href={DOWNLOAD.arm64}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.83-.81-3-.79-1.54.02-2.97.9-3.76 2.28-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.41-3.64zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.05-.52 2.68-1.28z" /></svg>
        {t.download}
      </a>
      <a class="intel" href={DOWNLOAD.x64}>{t.intel}</a>
      <a class="intel" href={LINKS.macApp}>{t.firstOpen}</a>
    </span>
    <Command command={INSTALL} />
    <a class="btn ghost docs" href={LINKS.docs}>{t.docs}</a>
  </div>
  <div class="perks">
    <span class="perk">
      <span class="ok"><svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="var(--faint)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5"></path></svg></span>
      {t.worksWith}
      <span class="logos">
        {
          AGENT_LOGOS.map(({ name, path, fill }) => (
            <svg width="16" height="16" viewBox="0 0 24 24" fill={fill} role="img" aria-label={name}>
              <title>{name}</title>
              <path d={path} />
            </svg>
          ))
        }
      </span>
    </span>
    <span class="perk">
      <span class="ok"><svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="var(--faint)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5"></path></svg></span>
      {t.noKey}
    </span>
  </div>
</header>

<style>
  .hero {
    padding-top: 48px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 12px 0 6px;
    border-radius: 999px;
    background: var(--sunk);
    font-size: 13px;
    color: var(--muted);
  }

  .eyebrow b {
    padding: 2px 8px;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-size: 12px;
    font-weight: 500;
  }

  h1 {
    margin: 22px 0 0;
    font-size: 68px;
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }

  .lede {
    max-width: 700px;
    margin: 24px 0 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
  }

  .lede :global(b) {
    font-weight: 500;
    color: var(--ink);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 36px;
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .get {
    height: 52px;
    padding: 0 20px;
    font-size: 15px;
  }

  .intel {
    font-size: 13px;
    color: var(--muted);
  }

  .intel:hover {
    color: var(--ink);
  }

  .docs {
    height: 52px;
    padding: 0 18px;
    font-size: 15px;
  }

  .perks {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    margin-top: 23px;
    font-size: 13px;
    color: var(--muted);
  }

  .perk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ok {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--sunk);
  }

  .logos {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 36px;
    }

    h1 {
      font-size: 56px;
    }

    .lede {
      font-size: 17px;
    }
  }

  @media (max-width: 560px) {
    h1 {
      font-size: 42px;
    }

    h1 :global(br) {
      display: none;
    }
  }
</style>
