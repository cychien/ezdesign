---
import Command from './Command.astro'
import { messages } from '../i18n'
import { AGENT_LOGOS } from '../lib/agents'
import { INSTALL, LINKS } from '../lib/links'

const t = messages(Astro.currentLocale).hero
---

<header class="hero" id="get-started">
  <span class="eyebrow"><b>MIT</b>{t.eyebrow}</span>
  <h1 set:html={t.title} />
  <p class="lede" set:html={t.lede} />
  <div class="cta">
    <Command command={INSTALL} />
    <a class="btn ghost docs" href={LINKS.docs}>{t.docs}</a>
  </div>
  <div class="perks">
    <span class="perk">
      <span class="ok"><svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="var(--faint)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5"></path></svg></span>
      {t.worksWith}
      <span class="logos">
        {
          AGENT_LOGOS.map(({ name, path, fill }) => (
            <svg width="16" height="16" viewBox="0 0 24 24" fill={fill} role="img" aria-label={name}>
              <title>{name}</title>
              <path d={path} />
            </svg>
          ))
        }
      </span>
    </span>
    <span class="perk">
      <span class="ok"><svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="var(--faint)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.2l2.3 2.3 4.7-5"></path></svg></span>
      {t.noKey}
    </span>
  </div>
</header>

<style>
  .hero {
    padding-top: 48px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 12px 0 6px;
    border-radius: 999px;
    background: var(--sunk);
    font-size: 13px;
    color: var(--muted);
  }

  .eyebrow b {
    padding: 2px 8px;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-size: 12px;
    font-weight: 500;
  }

  h1 {
    margin: 22px 0 0;
    font-size: 68px;
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.05em;
  }

  .lede {
    max-width: 700px;
    margin: 24px 0 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
  }

  .lede :global(b) {
    font-weight: 500;
    color: var(--ink);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 36px;
  }

  .docs {
    height: 52px;
    padding: 0 18px;
    font-size: 15px;
  }

  .perks {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    margin-top: 23px;
    font-size: 13px;
    color: var(--muted);
  }

  .perk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .ok {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--sunk);
  }

  .logos {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 36px;
    }

    h1 {
      font-size: 56px;
    }

    .lede {
      font-size: 17px;
    }
  }

  @media (max-width: 560px) {
    h1 {
      font-size: 42px;
    }

    h1 :global(br) {
      display: none;
    }
  }
</style>
