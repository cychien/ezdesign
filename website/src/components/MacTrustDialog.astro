---
import Cancel01Icon from '@hugeicons/core-free-icons/Cancel01Icon'
import Command from './Command.astro'
import Icon from './Icon.astro'
import { messages } from '../i18n'
import { TRUST_MAC_APP } from '../lib/links'

const t = messages(Astro.currentLocale).macTrust
---

<dialog id="mac-trust" class="trust" aria-labelledby="mac-trust-title" tabindex="-1">
  <form method="dialog">
    <button class="close" aria-label={t.close}><Icon icon={Cancel01Icon} size={16} /></button>
    <p class="kicker">{t.kicker}</p>
    <h3 id="mac-trust-title">{t.title}</h3>
    <p class="body">{t.body}</p>
    <ol>{t.steps.map((step) => <li set:html={step} />)}</ol>
    <p class="terminal">{t.terminal}</p>
    <Command command={TRUST_MAC_APP} size="sm" />
    <div class="actions">
      <button class="btn ink">{t.done}</button>
    </div>
  </form>
</dialog>

<script>
  const trust = document.querySelector<HTMLDialogElement>('#mac-trust')!
  trust.addEventListener('click', (event) => {
    if (event.target === trust) trust.close()
  })
</script>

<style>
  .trust {
    width: min(560px, 100vw - 32px);
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: #fff;
    color: var(--ink);
    box-shadow:
      0 0 0 1px rgb(23 23 23 / 0.08),
      0 24px 64px -12px rgb(0 0 0 / 0.24);
  }

  .trust:focus-visible {
    outline: none;
  }

  .trust::backdrop {
    background: rgb(28 27 25 / 0.32);
  }

  .trust[open] {
    animation: rise 0.2s ease-out;
  }

  .trust[open]::backdrop {
    animation: fade 0.2s ease-out;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  form {
    position: relative;
    padding: 28px;
  }

  .close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--faint);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .close:hover {
    background: var(--sunk);
    color: var(--ink);
  }

  .kicker {
    margin: 0;
  }

  h3 {
    margin: 8px 40px 0 0;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .body {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
  }

  ol {
    display: grid;
    gap: 14px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  li {
    position: relative;
    padding-left: 34px;
    font-size: 14px;
    line-height: 1.65;
    counter-increment: step;
  }

  li::before {
    content: counter(step);
    position: absolute;
    top: 1px;
    left: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sunk);
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }

  li :global(b) {
    font-weight: 500;
  }

  .terminal {
    margin: 22px 0 8px;
    padding-top: 20px;
    border-top: 1px solid var(--edge);
    font-size: 13px;
    color: var(--muted);
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .trust[open],
    .trust[open]::backdrop {
      animation: none;
    }
  }
</style>
